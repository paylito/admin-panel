# Baked into the static bundle at `vite build` (including the Docker image).
# The browser calls `${VITE_API_BASE}/admin/*` directly, so this must be the
# API's absolute, publicly reachable url. CORS is open on the API.
# Commit this file so clean checkouts / CI builds bake the right url too.
VITE_API_BASE=https://api.payli.to
